# /etc/drop/agent.env for drop-agent.service (docs/agent.md). No secret here:
# the node password is the credential /etc/drop/agent.secret (0600).

# The Drop server on this host and its domain (sent as the Host header).
DROP_AGENT_SERVER=http://127.0.0.1:8100
DROP_AGENT_HOST=drop-dev.bigconfig.space
# The node's name from `drop node create NAME --host-id HOST_ID`.
DROP_AGENT_NODE=walter-aws

# nibrunner's files.
DROP_AGENT_DESIRED=/var/lib/nibrunner/desired.json
DROP_AGENT_REPORTED=/var/lib/nibrunner/reported.json
DROP_AGENT_ARTIFACTS=/var/lib/nibrunner/artifact-store

# Every app hostname must end with this suffix.
DROP_AGENT_ALLOWED_HOST_SUFFIX=.bigconfig.space

# AWS: releases in S3, secrets in SSM, through the instance profile.
DROP_AWS_REGION=eu-north-1
DROP_S3_BUCKET=BUCKET
DROP_SSM_PREFIX=/drop

# Optional: DROP_AGENT_STATE_DIR (default $STATE_DIRECTORY, /var/lib/drop-agent),
# DROP_AGENT_PULL_INTERVAL (seconds, default 60), DROP_AGENT_REPORT_INTERVAL (default 30).
